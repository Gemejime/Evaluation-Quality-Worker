# ==============================================================================
# RAG Evaluation & Governance Worker (rag-eval-governance-worker)
# Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and adjust the values according to your environment.
# All environment variables declared here align with internal/config/settings.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service & Networking Configuration
# ------------------------------------------------------------------------------
# Service name identifier for distributed tracing and logging
SERVICE_NAME=rag-eval-governance-worker

# Host interface to bind internal ASGI Doc API / probe server (0.0.0.0 for containers)
HOST=0.0.0.0

# HTTP port for FastAPI ASGI server hosting /healthz, /ready, /metrics, and Doc API (/docs, /redoc, /api/docs)
PORT=8080

# Port for internal gRPC EvaluationWorkerService
GRPC_PORT=50051

# Deployment environment (development, staging, production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Runtime & Memory Management (ADR-002, Flat RSS <= 2.0 GiB)
# ------------------------------------------------------------------------------
# Preload jemalloc library to eliminate glibc arena memory fragmentation
LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2

# Python standard I/O and bytecode execution behavior
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ------------------------------------------------------------------------------
# 3. Temporal Workflow & Activity Orchestrator
# ------------------------------------------------------------------------------
# Temporal frontend service endpoint (host:port)
TEMPORAL_HOST=localhost:7233

# Temporal namespace hosting batch evaluation workflows
TEMPORAL_NAMESPACE=default

# Task queue polled by this evaluation worker instance
EVAL_TASK_QUEUE=eval-task-queue

# Frequency in seconds for activity worker progress heartbeat emission
ACTIVITY_HEARTBEAT_INTERVAL_SECONDS=10.0

# Maximum inactivity seconds before Temporal marks the activity heartbeat timed out
ACTIVITY_HEARTBEAT_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 4. Downstream LLM Judge Serving (Triton / vLLM)
# ------------------------------------------------------------------------------
# Base HTTP URL for Triton Inference Server / vLLM OpenAI-compatible judge endpoint
JUDGE_ENDPOINT=http://localhost:8001

# LLM model identifier for evaluation judgements
JUDGE_MODEL=meta-llama/Llama-3.1-70B-Instruct

# Maximum concurrent outbound judge requests (governed by concurrency semaphore)
JUDGE_MAX_CONCURRENT_REQUESTS=20

# Token-bucket rate limiter capacity (maximum queries per second)
JUDGE_RATE_LIMIT_RPS=50.0

# HTTP request timeout in seconds for downstream judge calls
JUDGE_REQUEST_TIMEOUT_SECONDS=45.0

# Maximum retry attempts on downstream HTTP 429 / RESOURCE_EXHAUSTED backpressure
JUDGE_429_MAX_RETRIES=5

# ------------------------------------------------------------------------------
# 5. Outbound Circuit Breaker & Exponential Backoff
# ------------------------------------------------------------------------------
# Consecutive downstream judge failures required to trip the circuit breaker OPEN
JUDGE_CB_FAILURE_THRESHOLD=5

# Cooldown duration in seconds before circuit breaker transitions to HALF-OPEN
JUDGE_CB_RESET_TIMEOUT_SECONDS=30.0

# Initial base backoff duration in seconds for exponential backoff with full jitter
JUDGE_BACKOFF_BASE_SECONDS=1.0

# Upper ceiling in seconds for exponential backoff delays
JUDGE_BACKOFF_MAX_SECONDS=30.0

# ------------------------------------------------------------------------------
# 6. Prompt Registry Service Integration (ADR-002)
# ------------------------------------------------------------------------------
# URL of the prompt registry service (falls back to native prompt templates if unreachable)
PROMPT_REGISTRY_URL=http://localhost:8080

# HTTP request timeout in seconds when querying the prompt registry service
PROMPT_REGISTRY_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# 7. ClickHouse Persistence & Metric Storage (ADR-003)
# ------------------------------------------------------------------------------
# ClickHouse cluster hostname or IP address
CLICKHOUSE_HOST=localhost

# ClickHouse HTTP client port
CLICKHOUSE_PORT=8123

# Database user with INSERT privileges to evaluation_runs and eval_metric_points
CLICKHOUSE_USER=eval_worker

# Database user password
CLICKHOUSE_PASSWORD=

# Target database name
CLICKHOUSE_DATABASE=rag_governance

# Micro-batch buffer threshold size (samples flushed once buffer reaches this count)
CLICKHOUSE_BATCH_SIZE=1000

# Periodic flush interval in seconds for buffered ClickHouse records
CLICKHOUSE_FLUSH_INTERVAL_SECONDS=1.0

# ------------------------------------------------------------------------------
# 8. Quality Gate Thresholds (Platform Release Gate tau >= 0.82)
# ------------------------------------------------------------------------------
# Minimum acceptable Faithfulness score threshold
QUALITY_GATE_MIN_FAITHFULNESS=0.82

# Minimum acceptable Context Precision score threshold
QUALITY_GATE_MIN_CONTEXT_PRECISION=0.82

# Minimum acceptable Answer Relevance score threshold
QUALITY_GATE_MIN_ANSWER_RELEVANCE=0.82
